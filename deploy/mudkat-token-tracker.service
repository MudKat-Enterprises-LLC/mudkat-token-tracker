[Unit]
Description=MudKat Token Tracker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/mudkat-token-tracker
EnvironmentFile=%h/.config/mudkat-token-tracker.env
ExecStart=/usr/bin/python3 tracker.py --db %h/.local/share/mudkat-token-tracker/tracker.sqlite3 serve --host 127.0.0.1 --port 9130
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mudkat-token-tracker

[Install]
WantedBy=default.target
